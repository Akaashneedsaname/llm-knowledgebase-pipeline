# Copy to .env and adjust. Everything works without a key (local embeddings,
# keyword labels, extractive answers). Add a Gemini key to enable LLM labeling
# and generated answers.

# Running outside Docker? Point at the compose database:
# DATABASE_URL=postgresql://kb:kb@localhost:5433/kb

# Embeddings: local (offline, 384-dim) or gemini (cloud, 768-dim)
EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional LLM for labeling and answers
GEMINI_API_KEY=
# GEMINI_LLM_MODEL=gemini-2.5-flash
# Safety cap on LLM calls per running process (then it falls back to non-LLM mode)
# LLM_MAX_CALLS=200
# Characters sent to the LLM for labeling each document
# LLM_LABEL_CHARS=4000

# OCR
# OCR_MIN_CHARS=40
# OCR_DPI=300
# OCR_LANG=eng

# Chunking (tokens)
# CHUNK_SIZE=400
# CHUNK_OVERLAP=60
